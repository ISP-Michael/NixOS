{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 13
    },
    "brightColor": false,
    "color": {
      "keys": "38;2;108;112;134",
      "separator": "38;2;108;112;134"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "38;2;137;180;250",
        "at": "38;2;108;112;134",
        "host": "38;2;205;214;244"
      }
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "host",
      "key": "  Host",
      "format": "{vendor} {family} ({name})"
    },
    {
      "type": "os",
      "key": "  OS",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "bootmgr",
      "key": "  Bootmgr",
      "format": "{name} ({firmware-name})"
    },
    {
      "type": "packages",
      "key": "  Packages",
      "format": "{nix-system} (nix-system)"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "  WM",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "display",
      "key": "  Display",
      "format": "{name} ({scaled-width}x{scaled-height} @ {refresh-rate} Hz)"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "  GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "  Memory"
    },
    {
      "type": "swap",
      "key": "  Swap"
    },
    {
      "type": "disk",
      "key": "  Disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({filesystem}, {size-percentage})"
    }
  ]
}
