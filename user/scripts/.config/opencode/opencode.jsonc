{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  },
  "plugins": [
    "/home/Michael/.config/opencode/plugins/memory-sync",
    "/home/Michael/.config/opencode/plugins/log-sanitizer",
    "/home/Michael/.config/opencode/plugins/searxng-search",
    "@hueyexe/opencode-ensemble@0.20.0"
  ],
  "websearch": {
    "provider": "searxng"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--executable-path",
          "/etc/profiles/per-user/Michael/bin/chromium",
          "--headless",
          "--isolated",
          "--no-sandbox"
        ],
        "timeout": 60000
      }
    }
  }
}
