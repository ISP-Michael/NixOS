{
  bat_h-l = "bat --highlight-line 0:";
  bnc = "brightnessctl";
  c = "clear";
  delete-shots = "find ~/Images/screenshots -maxdepth 1 -type f -name '*.png' -delete";
  dll = "dotnet bin/Debug/net*/*.dll";
  dn = "dotnet";
  e = "nvim";
  exa = "eza -laio --icons --git";
  exa-tree = "eza -aT -L=1 --icons";
  ff = "fastfetch --logo ~/Images/patterns_2.png";
  fucking = "sudo";
  g = "git";
  ga = "git add";
  gb = "git branch";
  gci = "git commit -m";
  gcl = "git clone";
  gco = "git checkout";
  gd = "git diff";
  gf = "git fetch";
  gl = "git log";
  gm = "git merge";
  gpll = "git pull";
  gpsh = "git push";
  grb = "git rebase";
  grl = "git reflog";
  grm = "git remote";
  grs = "git reset";
  grv = "git revert";
  gsb = "git submodule";
  gsh = "git stash";
  gsw = "git switch";
  home-rebuild = "ga . && home-manager switch --flake /etc/nixos";
  hyprshot = "hyprshot -o ~/Images/screenshots";
  ndw = "nmcli device wifi";
  py = "python";
  r = "reset";
  rebuild = "ga /etc/nixos && nixos-rebuild switch --sudo --flake /etc/nixos";
  rebuild-boot = "ga /etc/nixos && sudo nixos-rebuild boot --flake /etc/nixos";
  rgi = "rg -i";
  se = "sudoedit";
  update = "nix flake update --flake /etc/nixos";
  vmview = "spicy -h 127.0.0.1 -p 5900";
