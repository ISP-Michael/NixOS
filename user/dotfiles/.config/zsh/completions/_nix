#compdef nix

function _nix() {
  local input=("${(Q)words[@]}")
  local -a suggestions=() suggestions_display=()
  local tpe s d line max_width=0

  local -a output
  output=("${(@f)$(NIX_GET_COMPLETIONS=$((CURRENT - 1)) "$input[@]" 2>/dev/null)}")

  tpe="${output[1]}"

  local tab=$'\t'
  for line in "${output[@]:2}"; do
    s="${line%%${tab}*}"
    (( ${#s} > max_width )) && max_width=${#s}
  done

  for line in "${output[@]:2}"; do
    s="${line%%${tab}*}"
    d="${line#*${tab}}"
    suggestions+=("$s")
    if [[ -n "$d" ]]; then
      printf -v padded '%-*s' "$max_width" "$s"
      suggestions_display+=("$padded │ $d")
    else
      suggestions_display+=("$s")
    fi
  done

  local -a args=()
  if [[ "$tpe" == filenames ]]; then
    args+=('-f')
  elif [[ "$tpe" == attrs ]]; then
    args+=('-S' '')
  fi
  compadd -J nix "${args[@]}" -d suggestions_display -a suggestions
}

_nix "$@"
