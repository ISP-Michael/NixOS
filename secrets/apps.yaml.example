# Опциональный зашифрованный снимок живых файлов приложений.
# Живые секреты хранятся в настоящих директориях с 0600:
#   ~/.openclaw/openclaw.json
#   ~/.local/share/opencode/auth.json
#   ~/.local/state/opencode/service.json (пароль)
#
# Этот файл нужен только для переноса/восстановления. Создать/обновить:
#   user/scripts/.config/apps/backup.sh
# Восстановить:
#   user/scripts/.config/apps/restore.sh
#
# Если решишь хранить снимок — он должен быть зашифрован sops:
#   sops --config /etc/nixos/.sops.yaml -e -i secrets/apps.yaml
# Приватные ключи в git не попадают.

openclaw-json: |
  { "REPLACE": "сюда целиком openclaw.json" }
opencode-auth-json: |
  { "REPLACE": "сюда целиком auth.json" }
opencode-service-password: "REPLACE_ME"
telegram-bot-token: "REPLACE_ME"
