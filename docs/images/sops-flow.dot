digraph sops {
  graph [
    bgcolor="#1e1f22"
    fontname="DejaVu Sans"
    rankdir=LR
    nodesep=0.4
    ranksep=0.8
    pad=0.3
  ];
  node [
    shape=box
    style="rounded,filled"
    fillcolor="#26282c"
    color="#7aa2f7"
    fontcolor="#e6e6e6"
    fontname="DejaVu Sans"
    fontsize=12
    margin="0.18,0.10"
  ];
  edge [
    color="#7aa2f7"
    arrowsize=0.7
    fontcolor="#9aa5b1"
    fontname="DejaVu Sans"
    fontsize=11
  ];

  key [
    label="host SSH key\n/etc/ssh/ssh_host_ed25519_key\n(на машине, не в git)"
  ];
  policy [
    label=".sops.yaml\nпубличные age-получатели"
  ];
  vault [
    label="secrets/secrets.yaml\nENC[AES256_GCM, ...]"
    fillcolor="#3b4a6b"
  ];
  sops [
    label="sops-nix\nпри активации"
    fillcolor="#3b4a6b"
  ];
  run [
    label="/run/secrets\nuser-password · apps.yaml"
  ];
  users [
    label="пользователи и сервисы"
  ];

  policy -> vault [label="шифрование"];
  key -> sops [label="расшифровка"];
  vault -> sops;
  sops -> run;
  run -> users;
}
