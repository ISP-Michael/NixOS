digraph boot {
  graph [
    bgcolor="#1e1f22"
    fontname="DejaVu Sans"
    rankdir=LR
    nodesep=0.35
    ranksep=0.7
    pad=0.3
  ];
  node [
    shape=box
    style="rounded,filled"
    fillcolor="#26282c"
    color="#7aa2f7"
    fontcolor="#e6e6e6"
    fontname="DejaVu Sans"
    fontsize=12
    margin="0.18,0.10"
  ];
  edge [
    color="#7aa2f7"
    arrowsize=0.7
    fontcolor="#9aa5b1"
    fontname="DejaVu Sans"
    fontsize=11
  ];

  subgraph cluster_host {
    label="MagicBook: обычная загрузка"
    fontcolor="#9aa5b1"
    color="#33363b"
    style="rounded,dashed"

    uefi1 [label="UEFI" fillcolor="#3b4a6b"];
    boot [label="systemd-boot\n/boot"];
    host [label="NixOS 26.11\nHyprland + greetd"];

    uefi1 -> boot -> host;
  }

  subgraph cluster_live {
    label="Live-ISO: загрузка и установка"
    fontcolor="#9aa5b1"
    color="#33363b"
    style="rounded,dashed"

    uefi2 [label="UEFI" fillcolor="#3b4a6b"];
    ventoy [label="Ventoy\nUSB"];
    live [label="iso-* live\nHyprland"];
    disko [label="disko\nразметка диска"];
    install [label="nixos-install\n--flake /etc/nixos#MagicBook"];

    uefi2 -> ventoy -> live -> disko -> install;
  }
}
